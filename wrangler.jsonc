{
  // Configuración del sitio Perfuma en Cloudflare Workers.
  // El nombre debe coincidir con el nombre del Worker en el panel de Cloudflare.
  "name": "perfuma-app",
  "main": "worker.js",
  "compatibility_date": "2026-11-14",

  // El comando de build (ver package.json) copia a public/ sólo los archivos
  // que deben quedar públicos en internet. Lo que no esté ahí no se publica:
  // ni app.py, ni los Excel con costos, ni este archivo.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Almacén de caché para las lecturas de Fragrantica: la segunda vez que
  // alguien busca el mismo perfume, en cualquier tienda, sale al instante.
  "kv_namespaces": [
    { "binding": "CACHE_FRAG", "id": "422f1f577fcf499ca08ca7953ca204e7" }
  ],

  "observability": { "enabled": true }
}
